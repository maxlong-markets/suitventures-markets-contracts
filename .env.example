# Copy to .env (git-ignored) and fill in. Placeholders only in this file: never commit a real
# private key, an RPC key or a real wallet address. The deployer key is never an environment
# variable; pass it to forge with --account, --ledger or --interactive.

# Robinhood Chain RPC. The public endpoint needs no key. Used by the `robinhood` alias in
# foundry.toml and by the fork tests, which are skipped when this is unset.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional. The block the fork tests run at; unset means the block pinned in test/fork/SVRouterFork.t.sol.
# The public endpoint keeps only about the last 50_000 blocks of state (roughly 80 minutes at this chain's
# ~0.1 s blocks), so a run long after the pin needs a recent block here instead.
# ROBINHOOD_FORK_BLOCK=

# Inputs of script/Deploy.s.sol.
# Ownable2Step owner: Kobe's EOA at deploy, MAXLONG's Safe at M5.
OWNER=0x0000000000000000000000000000000000000000
# Receives the router fee.
FEE_WALLET=0x0000000000000000000000000000000000000000
# Suits NFT. Zero (or unset) disables the holder perk; the address is TBD.
SUITS_NFT=0x0000000000000000000000000000000000000000
# Chain facts (spec section 2): the current Universal Router (D38) and the canonical Permit2.
UNIVERSAL_ROUTER=0x06AfBA43Fd06227fA663b0DAecF536f6EaA6bf99
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
# The deploy script refuses any other router or Permit2 address unless this is set to true on purpose.
# ALLOW_OTHER_ADDRESSES=true

# Inputs of script/DeployLaunchpad.s.sol, in addition to OWNER, FEE_WALLET, PERMIT2 and ALLOW_OTHER_ADDRESSES
# above. The ERC-721 whose holders may launch: the Suits NFT on Robinhood Chain. Zero lets anyone launch.
LAUNCHER_GATE=0x05C2174aa494BBDf72AEeab0cA3C10216D33B297
# Optional. The Uniswap v4 PoolManager; unset means the chain's. The script refuses another address unless
# ALLOW_OTHER_ADDRESSES=true.
# POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
